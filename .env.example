# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/multilingual_training

# ─── LLM Provider ──────────────────────────────────────────────────────────
# Default provider used when no per-task override is set.
# Supported: openai | anthropic | deepseek
LLM_PROVIDER=openai

# Default model for the default provider.
# OpenAI example:     gpt-4o, gpt-4o-mini, gpt-4.1
# Anthropic example:  claude-sonnet-4-6, claude-haiku-4-5
# OpenAI-compatible:  deepseek-chat (DeepSeek), qwen-plus (Qwen), or any custom endpoint
LLM_MODEL=gpt-4o

# API Keys
# For OpenAI / OpenAI-compatible (DeepSeek, Qwen, Groq, etc.):
OPENAI_API_KEY=
# For custom base URL (e.g. DeepSeek: https://api.deepseek.com, Ollama: http://localhost:11434/v1):
# OPENAI_BASE_URL=https://api.openai.com/v1
# For Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# For DeepSeek (uses OpenAI-compatible protocol, base URL auto-set to https://api.deepseek.com):
# DEEPSEEK_API_KEY=sk-...

# ─── Per-Task LLM Routing (optional) ───────────────────────────────────────
# Route different tasks to different providers/models for cost & quality.
# Each task falls back to LLM_PROVIDER / LLM_MODEL if not configured.

# Translation: high throughput, can use cheaper/faster models
# LLM_TRANSLATE_PROVIDER=openai
# LLM_TRANSLATE_MODEL=gpt-4o-mini

# AI Explanation: needs strong reasoning, use best-in-class model
# LLM_EXPLAIN_PROVIDER=anthropic
# LLM_EXPLAIN_MODEL=claude-sonnet-4-6

# ─── Authentication (JWT) ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Dashboard admin session secret (optional but recommended — must be ≥ 32 chars).
# When set, the dashboard session cookie uses this independent secret instead of
# JWT_SECRET, so a leaked learner JWT secret cannot forge a dashboard session.
# DASHBOARD_JWT_SECRET=

# Dashboard setup key (optional). Required to bootstrap the first admin via
# /dashboard setup. When unset, the setup endpoint is disabled entirely.
# DASHBOARD_SETUP_KEY=change-this-to-a-random-setup-key

# ─── OIDC SSO (optional — for future internal login integration) ───────────
# Uncomment and configure when the internal OIDC provider is available.
# OIDC_ISSUER_URL=https://sso.company.com/auth/realms/your-realm
# OIDC_CLIENT_ID=multilingual-training-platform
# OIDC_CLIENT_SECRET=
# OIDC_JWKS_URL=https://sso.company.com/auth/realms/your-realm/protocol/openid-connect/certs

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=
UPLOADS_DIR=

# ─── File Storage ──────────────────────────────────────────────────────────
# Currently uses an S3-compatible API via Forge/Manus.
# Leave these empty to use local filesystem storage (development).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Manus/Forge (legacy — optional, for backward compatibility) ──────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── OAuth (optional) ──────────────────────────────────────────────────────
# OAuth server URL for legacy Manus authentication
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ─── MinerU Agent Parse (optional, used as fallback for non-DOCX extraction) ───
# See: https://mineru.net/apiManage/docs
MINERU_BASE_URL=https://mineru.net
MINERU_TIMEOUT_SECONDS=120
MINERU_API_KEY=
